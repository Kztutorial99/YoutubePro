<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item android:gravity="center" android:right="3.0dip">
                <shape android:shape="rectangle">
                    <stroke android:width="0.5dip" android:color="#0a000000" />
                    <size android:height="11.0dip" android:width="11.0dip" />
                    <corners android:radius="6.0dip" />
                    <solid android:color="#ffffffff" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_checked="false">
        <layer-list>
            <item android:gravity="center" android:left="3.0dip">
                <shape android:shape="rectangle">
                    <stroke android:width="0.5dip" android:color="#0a000000" />
                    <size android:height="11.0dip" android:width="11.0dip" />
                    <corners android:radius="6.0dip" />
                    <solid android:color="#b3ffffff" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
